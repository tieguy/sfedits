# The fork renders diffs natively (satori + resvg); Puppeteer is an optional
# fallback that is never used on Toolforge. Without this, `npm install` on the
# build service downloads ~150MB of Chromium that nothing runs. The Dockerfile
# sets PUPPETEER_SKIP_CHROMIUM_DOWNLOAD for the container path; the build
# service uses buildpacks and never reads that Dockerfile, so it needs this.
puppeteer_skip_download=true
